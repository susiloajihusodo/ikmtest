rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Thumbnail album: publik bisa baca, admin bisa tulis
    match /thumbnails/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
    // Lampiran informasi: publik bisa baca, admin bisa tulis
    match /information/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
